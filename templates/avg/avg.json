  "scenes": {
    "s1_tea": {
      "title": "第一幕　颱風過後",
      "cast": [
        "you",
        "shangdi",
        "kang",
        "zhao"
      ],
      "bg": [
        "#8a7f6a",
        "#3d4a5c"
      ],
      "hint": "長輩說：先奉長輩。（各家習慣不同，這裡是簡化）",
      "fieldwork": [
        "fw_tea"
      ],
      "src": [
        {
          "k": "原著",
          "t": "第一回：七月三日夜颱風吹倒小廟，三位神明挨餓。第二回：只有廟祝的一壺清茶，趙元帥抱怨站著的人才知道餓。"
        },
        {
          "k": "工坊創作",
          "t": "你是廟祝這個視角；原書三位神明一起領茶，奉茶先後與它對面子的影響是工坊自己加的玩法。"
        }
      ],
      "lines": [
        {
          "who": "narr",
          "text": "七月三日夜，颱風把小廟吹倒了。天亮之後，廟埕只剩一堆歪掉的樑柱。"
        },
        {
          "who": "narr",
          "text": "坐在殘垣中間的是三位神明：到任半年的上帝爺，還有輔佐他的兩位元帥——紅臉的康元帥、青臉的趙元帥。他們已經餓了好幾天。"
        },
        {
          "who": "narr",
          "text": "你是這座小廟的廟祝。你全部的家當，只剩一壺清茶。"
        },
        {
          "who": "zhao",
          "mood": "sad",
          "text": "站在底下的人才知道餓，坐在上面的人哪裡曉得。"
        },
        {
          "who": "kang",
          "mood": "worry",
          "text": "（肚子叫了一聲，他假裝沒聽見）"
        },
        {
          "who": "shangdi",
          "mood": "sad",
          "text": "颱風來得快，去得也快。人餓著，倒比風還難過。"
        },
        {
          "who": "narr",
          "text": "上帝爺什麼也沒說，只是看著倒下的屋樑。"
        }
      ],
      "choices": [
        {
          "id": "tea_first_god",
          "text": "雙手捧茶，先奉給上帝爺",
          "tone": "neutral",
          "result": [
            "上帝爺接過茶杯，點了一下頭。康、趙兩位元帥等著你，也沒有出聲。"
          ],
          "goto": "s2_crown"
        },
        {
          "id": "tea_first_marshals",
          "text": "康、趙兩位看起來最餓，先奉給他們",
          "tone": "neutral",
          "cset": {
            "served_wrong": true
          },
          "add": {
            "face": -1
          },
          "result": [
            "康元帥一口就喝乾了。上帝爺沒說話，只是把視線移開，輕輕咳了一聲。"
          ],
          "skin": {
            "result": [
              "康元帥一口就喝乾了。上帝爺笑笑，說沒關係，他等一下再喝。"
            ]
          },
          "goto": "s2_crown"
        }
      ]
    },
    "s2_crown": {
      "title": "第二幕　銅鍍金的通天冠",
      "cast": [
        "shangdi",
        "kang",
        "zhao",
        "you"
      ],
      "bg": [
        "#9a8a5a",
        "#4a3d2d"
      ],
      "hint": "長輩說：和資歷差很多的人說話，要先找中間人，或是先讓對方記得你的情。（簡化的說法）",
      "src": [
        {
          "k": "原著",
          "t": "第二回：上帝爺脫下銅鍍金的通天冠，交康、趙拿去打銀街的同裕當店典當。"
        },
        {
          "k": "改編",
          "t": "『看來世上金能語』這句話原著出現在第一回（受冷落時說的），這裡借來放在摘冠之前。"
        },
        {
          "k": "工坊創作",
          "t": "你的香油錢與勸說；欠人情會隨時間變重，是工坊自己加的玩法。"
        }
      ],
      "lines": [
        {
          "who": "shangdi",
          "mood": "sad",
          "text": "看來世上金能語。"
        },
        {
          "who": "narr",
          "text": "他慢慢摘下頭上那頂銅鍍金的通天冠。沒了冠，頭髮披散下來，他也顧不得了。"
        },
        {
          "who": "shangdi",
          "mood": "normal",
          "text": "康、趙，把這個拿去打銀街的同裕當店，換點米回來。"
        },
        {
          "who": "kang",
          "mood": "worry",
          "text": "遵命。"
        },
        {
          "who": "narr",
          "text": "兩位元帥把冠抱在懷裡，出了門。"
        },
        {
          "who": "kang",
          "mood": "worry",
          "text": "（走到門口又回頭）上帝爺，這可是您上天庭要戴的冠……"
        },
        {
          "who": "shangdi",
          "mood": "normal",
          "text": "上天庭的事，等有飯吃了再說。去吧。"
        },
        {
          "who": "narr",
          "text": "你摸摸袖子裡的錢袋——那是廟裡這陣子收到的香油錢，不多。"
        }
      ],
      "choices": [
        {
          "id": "give_money",
          "text": "把香油錢袋遞給上帝爺：「先拿這個吧。」",
          "tone": "good",
          "set": {
            "offered_savings": true
          },
          "add": {
            "favor": 1
          },
          "result": [
            "上帝爺看看錢袋，又看看你。「不夠買米。」他說，「但本座記著了。」",
            "冠還是被拿走了。你的錢袋，只夠一頓粥。"
          ],
          "goto": "s2b_pawn"
        },
        {
          "id": "advise_god",
          "text": "勸他：「冠是您上天庭要戴的，別當。」",
          "address": "shangdi",
          "tone": "neutral",
          "result": [
            "上帝爺嘆了一口氣：「餓著肚子，哪裡還顧得上天庭的體統。」",
            "冠還是被拿走了。"
          ],
          "goto": "s2b_pawn"
        },
        {
          "id": "keep_quiet",
          "text": "低下頭，什麼都沒說",
          "tone": "neutral",
          "set": {
            "kept_quiet": true
          },
          "result": [
            "你把錢袋收回袖子裡。"
          ],
          "goto": "s2b_pawn"
        }
      ]
    },
    "s2b_pawn": {
      "title": "第二幕之一　打銀街的當店",
      "cast": [
        "kang",
        "zhao",
        "you"
      ],
      "bg": [
        "#8a7a4a",
        "#3a2f22"
      ],
      "hint": "長輩說：東西當出去，白紙黑字的當票比嘴巴可靠。（簡化的說法）",
      "src": [
        {
          "k": "原著",
          "t": "第二回：康、趙把通天冠提往打銀街的同裕當店典借，當出五千錢。"
        },
        {
          "k": "工坊創作",
          "t": "你跟到當店、當票上的字、掌櫃的台詞與「三個月內可贖」；原著對這間當店沒有任何人物或擺設描寫。"
        }
      ],
      "lines": [
        {
          "who": "narr",
          "text": "你不放心，悄悄跟在康、趙後頭，走進打銀街的同裕當店。"
        },
        {
          "who": "narr",
          "text": "掌櫃把通天冠翻來覆去看了三遍，才慢吞吞地說：「銅鍍金的。五千錢，不能再多了。」"
        },
        {
          "who": "kang",
          "mood": "worry",
          "text": "五千就五千……"
        },
        {
          "who": "narr",
          "text": "他們收下錢，掌櫃撕了一張當票，遞給康元帥。康元帥看也沒看，隨手塞進袖子。"
        }
      ],
      "choices": [
        {
          "id": "copy_ticket",
          "text": "趁他們不注意，把當票上的字默默記下來",
          "tone": "good",
          "set": {
            "got_ticket": true
          },
          "result": [
            "你把當票上的字在心裡背了一遍：同裕當店、通天冠一頂、五千錢。（遊戲設定：這個記憶之後可以當證據。）"
          ],
          "goto": "s3_gate"
        },
        {
          "id": "ask_redeem",
          "text": "問掌櫃：「這頂冠，要贖回來得多少錢？」",
          "tone": "neutral",
          "set": {
            "knows_redeem": true
          },
          "result": [
            "掌櫃撥著算盤：「本錢五千，再加一點利息。三個月內來贖，我替你留著。」（遊戲設定：贖冠的期限與利息是工坊編的。）",
            "你把這句話記在心裡。"
          ],
          "goto": "s3_gate"
        },
        {
          "id": "wait_outside",
          "text": "退到店門口，等他們出來",
          "tone": "neutral",
          "result": [
            "你在門口數著路過的人，什麼也沒聽見。康、趙出來時，袖子鼓鼓的，兩個人都沒說話。"
          ],
          "goto": "s3_gate"
        }
      ]
    },
    "s3_gate": {
      "title": "第三幕　媽祖宮口的門檻",
      "cast": [
        "qianli",
        "shunfeng",
        "kang",
        "zhao"
      ],
      "bg": [
        "#7a8f6a",
        "#2f4a3d"
      ],
      "hint": "有人說，進廟門腳要抬過去，不要踩在門檻上。（各家說法不同，這裡是簡化）",
      "fieldwork": [
        "fw_threshold"
      ],
      "src": [
        {
          "k": "原著",
          "t": "第二回：康、趙在媽祖宮口與天上聖母的手下千里眼、順風耳賭『拋璉寶』，把當冠換來的五千錢輸光。"
        },
        {
          "k": "改編",
          "t": "原書裡千里眼、順風耳關廟門是上帝爺趕來時躲避，這裡挪成踩門檻的後果；趙元帥商量說詞，原書是兩人糊裡糊塗地講。"
        },
        {
          "k": "工坊創作",
          "t": "你跟蹤他們、躲進廟埕偷聽的視角；賭攤的台詞；門檻禁忌的玩法（民間說法的簡化，不是原著情節）。"
        }
      ],
      "lines": [
        {
          "who": "narr",
          "text": "你不放心，悄悄跟著兩位元帥，走到府城大廟前——媽祖宮口。"
        },
        {
          "who": "narr",
          "text": "廟門口熱鬧得很。天上聖母的兩位手下，千里眼和順風耳，正圍著一塊地賭「拋璉寶」。"
        },
        {
          "who": "shunfeng",
          "mood": "grin",
          "text": "再來一把！輸的付錢，贏的收錢！"
        },
        {
          "who": "narr",
          "text": "康、趙兩位元帥站在賭攤旁邊，手裡捏著用通天冠換來的錢袋。"
        },
        {
          "who": "narr",
          "text": "那個錢袋，原本是要換米的。"
        },
        {
          "who": "narr",
          "text": "想聽清楚他們說什麼，得越過廟門那道高高的門檻，躲進廟埕裡。"
        }
      ],
      "choices": [
        {
          "id": "step_on",
          "text": "一腳踩上門檻，探身往裡看",
          "tone": "bad",
          "taboo": true,
          "cset": {
            "taboo_broken": true
          },
          "result": [
            "你的腳剛踩上門檻，門裡的人全都轉過頭來。順風耳臉色一沉，「砰」的一聲，大門當著你的面關上了。",
            "你什麼也沒看到，只聽見裡面有人嘆氣：「又輸了……」"
          ],
