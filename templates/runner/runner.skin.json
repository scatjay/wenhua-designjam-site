  "field": {
    "title": "AI 做不到的欄位：去問一個真的出巡規矩",
    "prompt": "去看一次廟會、遶境或進香，或問一位廟方的人、轎班、長輩：「神轎要休息或停下來的時候，有什麼規矩？」、「這間廟先拜哪一尊？」寫下你問了誰（不用寫名字，寫身分就好）、他怎麼說。",
    "placeholder": "例：我問了＿＿廟的＿＿，他說神轎＿＿的時候，要＿＿。所以規則可以改成：＿＿。",
    "min_chars": 15
  },
  "basis": [
    {
      "tag": "原著",
      "text": "康、趙二元帥輔佐小上帝；他們帶著典當通天冠換來的錢，路過媽祖宮口，跟千里眼、順風耳賭「拋璉寶」，輸光了錢（《小封神》第二回）。安海街的土地公也是原著人物（第十八至二十回）。"
    },
    {
      "tag": "原著（提醒）",
      "text": "賭攤是原著的諷刺：康、趙賭輸了錢還說謊，最後被罰。遊戲讓賭攤有一點誘惑，但代價更大，不是在鼓勵賭博。"
    },
    {
      "tag": "民間",
      "text": "遶境又叫巡境、出巡，路線由廟方與地方人士組成的主辦團體安排，各地方式不同；沿途家戶擺香案。"
    },
    {
      "tag": "民間（各廟不同）",
      "text": "拜拜常見的順序是天公先、主神次、陪祀神最後；多尊神像時的左右先後說法不一，以廟方立牌為準。"
    },
    {
      "tag": "工坊創作",
      "text": "整條路線、路障、體力、分數都是遊戲編的；小上帝出巡、經過媽祖宮口與安海街，原著沒有這一段。"
    },
    {
      "tag": "遊戲設定（還要再查證）",
      "text": "「神轎停下來要回到上一間廟前重新出發」「拜錯要重來」「進土地公廟拜」都是遊戲為了讓規矩變成玩法而定的；真的遶境有排好的休息與駐駕，各廟做法要以現場為準。"
    }
  ],
